+  function sessionName(index) {
+    return (sessionModel.data(sessionModel.index(index, 0), Qt.UserRole + 1) || "").toString()
+  }
+
+  function cycleSession(step) {
+    var count = sessionModel.rowCount()
+    if (count > 0)
+      root.sessionIndex = (root.sessionIndex + step + count) % count
+  }
+
   function preferredSessionIndex() {
     var lastIndex = sessionModel.lastIndex
-    if (sessionFile(lastIndex) === "omarchy.desktop")
+    if (sessionFile(lastIndex) === "hyprland.desktop")
       return lastIndex

     for (var i = 0; i < sessionModel.rowCount(); i++) {
-      if (sessionFile(i) === "omarchy.desktop")
+      if (sessionFile(i) === "hyprland.desktop")
         return i
     }

     for (var j = 0; j < sessionModel.rowCount(); j++) {
-      if (sessionExec(j).indexOf("uwsm start -g -1 -e -D Hyprland") === 0)
+      if (sessionExec(j).indexOf("start-hyprland") !== -1)
         return j
     }
     return lastIndex
@@ -132,10 +142,34 @@ Rectangle {
           Keys.onPressed: {
-            if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
+            if (event.key === Qt.Key_Tab) {
+              root.cycleSession(event.modifiers & Qt.ShiftModifier ? -1 : 1)
+              event.accepted = true
