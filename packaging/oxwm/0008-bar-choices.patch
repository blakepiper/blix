+fn parseChoices(state: *c.lua_State, idx: c_int) ?config_mod.ChoicesConfig {
+    const cfg = config orelse return null;
+    const top = c.lua_gettop(state);
+    defer c.lua_settop(state, top);
+    _ = c.lua_getfield(state, idx, "label");
+    const label = dupeLuaString(state, -1) orelse "Choose";
+    _ = c.lua_getfield(state, idx, "read_command");
+    const read_command = dupeLuaString(state, -1) orelse return null;
+    _ = c.lua_getfield(state, idx, "options");
+    if (c.lua_type(state, -1) != c.LUA_TTABLE) return null;
+    const count = c.lua_rawlen(state, -1);
+    if (count < 2 or count > 8) return null;
+    const options = cfg.string_arena.allocator().alloc(config_mod.ChoiceOption, count) catch return null;
+    for (options, 0..) |*option, i| {
+        _ = c.lua_rawgeti(state, -1, @intCast(i + 1));
+        if (c.lua_type(state, -1) != c.LUA_TTABLE) return null;
+        _ = c.lua_getfield(state, -1, "label");
+        const text = dupeLuaString(state, -1) orelse return null;
+        c.lua_settop(state, -2);
+        _ = c.lua_getfield(state, -1, "value");
+        const value = dupeLuaString(state, -1) orelse return null;
+        // Values are substituted into shell commands; accept only plain tokens.
+        if (text.len == 0 or text.len > 48 or value.len == 0 or value.len > 64) return null;
+        for (value) |byte| if (!std.ascii.isAlphanumeric(byte) and byte != '-' and byte != '_') return null;
+        for (options[0..i]) |previous| if (std.mem.eql(u8, previous.value, value)) return null;
+        option.* = .{ .label = text, .value = value };
+        c.lua_settop(state, -3);
+    }
+    return .{ .label = label, .read_command = read_command, .options = options };
+}
