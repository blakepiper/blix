+    fn loadLogo(self: *Bar, display: *xlib.Display, path: ?[]const u8) void {
+        const logo_path = path orelse return;
+        const path_z = self.allocator.dupeZ(u8, logo_path) catch return;
+        defer self.allocator.free(path_z);
+
+        var attributes: xlib.c.XpmAttributes = std.mem.zeroes(xlib.c.XpmAttributes);
+        attributes.valuemask = xlib.c.XpmSize;
+        defer xlib.c.XpmFreeAttributes(&attributes);
+        const status = xlib.c.XpmReadFileToPixmap(display, self.window, path_z.ptr,
+            &self.logo_pixmap, &self.logo_mask, &attributes);
+        if (status != xlib.c.XpmSuccess or attributes.height > self.height or attributes.width > self.width) {
+            std.debug.print("unable to load bar logo {s}: Xpm status {d} or oversized image\n", .{ logo_path, status });
+            if (self.logo_pixmap != 0) _ = xlib.XFreePixmap(display, self.logo_pixmap);
+            if (self.logo_mask != 0) _ = xlib.XFreePixmap(display, self.logo_mask);
+            self.logo_pixmap = 0;
+            self.logo_mask = 0;
+            return;
+        }
+        self.logo_width = @intCast(attributes.width);
+        self.logo_height = @intCast(attributes.height);
+    }
+
+    fn tagOffset(self: *Bar) i32 {
+        return if (self.logo_pixmap != 0) self.logo_width + 16 else 0;
+    }
+
     pub fn addBlock(self: *Bar, block: Block) void {
