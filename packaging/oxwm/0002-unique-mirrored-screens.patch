+    const UniqueScreens = struct {
+        storage: []xlib.XineramaScreenInfo,
+        count: usize,
+    };
+
+    fn collectUniqueScreens(
+        self: *WindowManager,
+        screens: [*c]xlib.XineramaScreenInfo,
+        screen_count: usize,
+    ) ?UniqueScreens {
+        const storage = self.allocator.alloc(xlib.XineramaScreenInfo, screen_count) catch return null;
+        var unique_count: usize = 0;
+
+        for (0..screen_count) |index| {
+            const screen = screens[index];
+            var duplicate = false;
+            for (storage[0..unique_count]) |previous| {
+                if (previous.x_org == screen.x_org and
+                    previous.y_org == screen.y_org and
+                    previous.width == screen.width and
+                    previous.height == screen.height)
+                {
+                    duplicate = true;
+                    break;
+                }
+            }
+            if (duplicate) continue;
+
+            storage[unique_count] = screen;
+            unique_count += 1;
+        }
+
+        return .{ .storage = storage, .count = unique_count };
+    }
