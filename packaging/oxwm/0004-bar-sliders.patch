diff --git a/src/config/lua.zig b/src/config/lua.zig
index fbf673d..d78f7bc 100644
--- a/src/config/lua.zig
+++ b/src/config/lua.zig
@@ -1333,7 +1333,28 @@ fn parseClickAction(state: *c.lua_State, idx: c_int) ?config_mod.ClickAction {
         const bypass_rules = c.lua_toboolean(state, -1) != 0;
         c.lua_settop(state, -2);
 
-        return .{ .command = cmd.?, .floating = floating, .bypass_rules = bypass_rules };
+        var slider: ?config_mod.SliderConfig = null;
+        _ = c.lua_getfield(state, idx, "slider");
+        if (c.lua_type(state, -1) == c.LUA_TTABLE) {
+            _ = c.lua_getfield(state, -1, "label");
+            const label = dupeLuaString(state, -1) orelse "Level";
+            c.lua_settop(state, -2);
+            _ = c.lua_getfield(state, -1, "min");
+            const min = if (c.lua_isinteger(state, -1) != 0) c.lua_tointegerx(state, -1, null) else 0;
+            c.lua_settop(state, -2);
+            _ = c.lua_getfield(state, -1, "max");
+            const max = if (c.lua_isinteger(state, -1) != 0) c.lua_tointegerx(state, -1, null) else 100;
+            c.lua_settop(state, -2);
+            if (min < 0 or max > 100 or min >= max or std.mem.indexOf(u8, cmd.?, "{}") == null) {
+                std.debug.print("slider: require 0 <= min < max <= 100 and a command containing {{}}\n", .{});
+                c.lua_settop(state, -2);
+                return null;
+            }
+            slider = .{ .label = label, .min = @intCast(min), .max = @intCast(max) };
+        }
+        c.lua_settop(state, -2);
+
+        return .{ .command = cmd.?, .floating = floating, .bypass_rules = bypass_rules, .slider = slider };
     }
     return null;
 }
