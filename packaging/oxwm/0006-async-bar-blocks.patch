+        if (c.posix_spawn_file_actions_init(&actions) != 0) return;
+        defer _ = c.posix_spawn_file_actions_destroy(&actions);
+        if (c.posix_spawn_file_actions_adddup2(&actions, pipe[1], c.STDOUT_FILENO) != 0 or
+            c.posix_spawn_file_actions_addclose(&actions, pipe[0]) != 0 or
+            c.posix_spawn_file_actions_addclose(&actions, pipe[1]) != 0 or
+            c.posix_spawn_file_actions_addopen(&actions, c.STDIN_FILENO, "/dev/null", c.O_RDONLY, 0) != 0 or
+            c.posix_spawn_file_actions_addopen(&actions, c.STDERR_FILENO, "/dev/null", c.O_WRONLY, 0) != 0) return;
+
+        var attributes: c.posix_spawnattr_t = undefined;
+        if (c.posix_spawnattr_init(&attributes) != 0) return;
+        defer _ = c.posix_spawnattr_destroy(&attributes);
+        if (c.posix_spawnattr_setflags(&attributes, c.POSIX_SPAWN_SETPGROUP) != 0 or
+            c.posix_spawnattr_setpgroup(&attributes, 0) != 0) return;
+        var argv = [_][*c]u8{ @constCast("/bin/sh"), @constCast("-c"), command.ptr, null };
+        var pid: c.pid_t = undefined;
+        if (c.posix_spawn(&pid, "/bin/sh", &actions, &attributes, &argv, c.environ) != 0) return;
+
+        keep_read_end = true;
+        self.pid = pid;
+        self.group = pid;
+        self.fd = pipe[0];
+        self.output_len = 0;
+        self.started_at = now;
+        self.timed_out = false;
+    }
