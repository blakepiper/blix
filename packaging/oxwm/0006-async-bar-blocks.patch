+            for (0..4) |_| {
+                const count = c.read(fd, &chunk, chunk.len);
+                if (count > 0) {
+                    const length = @min(@as(usize, @intCast(count)), self.output.len - self.output_len);
+                    @memcpy(self.output[self.output_len..][0..length], chunk[0..length]);
+                    self.output_len += length;
+                } else if (count == 0 or (count < 0 and c.__errno_location().* != c.EAGAIN and c.__errno_location().* != c.EINTR)) {
+                    _ = c.close(fd);
+                    self.fd = null;
+                    while (self.output_len > 0 and (self.output[self.output_len - 1] == '\n' or self.output[self.output_len - 1] == '\r')) {
+                        self.output_len -= 1;
+                    }
+                    if (!self.timed_out) result = format_util.substitute(self.format, self.output[0..self.output_len], buffer);
