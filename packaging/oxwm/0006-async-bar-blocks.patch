+    /// Spawn without waiting. Each block owns at most one collector and retains
+    /// its previous display value until the next complete result arrives.
+    pub fn start(self: *Shell, gpa: std.mem.Allocator, now: i64) void {
+        if (self.running()) return;
+        const command = gpa.dupeZ(u8, self.command) catch return;
+        defer gpa.free(command);
+
+        var pipe: [2]c_int = undefined;
+        if (c.pipe2(&pipe, c.O_CLOEXEC) != 0) return;
+        defer _ = c.close(pipe[1]);
+        var keep_read_end = false;
+        defer if (!keep_read_end) {
+            _ = c.close(pipe[0]);
+        };
+        if (c.fcntl(pipe[0], c.F_SETFL, @as(c_int, c.O_NONBLOCK)) != 0) return;
+
