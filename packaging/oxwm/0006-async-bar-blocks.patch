+test "slow collectors return immediately, do not overlap, and publish complete formatted output" {
+    var shell = Shell.init("Vol {}", "sleep 0.2; printf '37%% (muted)\\r\\n'", 1, 0);
+    defer shell.deinit();
+    var buffer: [256]u8 = undefined;
+    shell.start(std.testing.allocator, 0);
+    try std.testing.expect(shell.running());
+    const pid = shell.pid;
+    shell.start(std.testing.allocator, 0);
+    try std.testing.expectEqual(pid, shell.pid);
+    try std.testing.expectEqual(null, shell.collect(0, &buffer));
+    var result: ?[]const u8 = null;
+    for (0..200) |_| {
+        if (shell.collect(0, &buffer)) |content| {
+            result = content;
+            break;
+        }
+        _ = c.usleep(10000);
+    }
+    try std.testing.expectEqualStrings("Vol 37% (muted)", result orelse return error.NoOutput);
+    try std.testing.expectEqual(null, shell.collect(0, &buffer));
+}
+
+test "large stdout is drained and truncated without retaining stderr or unbounded memory" {
+    var shell = Shell.init("", "i=0; while [ $i -lt 64 ]; do printf '%01024d' 0; printf '%01024d' 0 >&2; i=$((i+1)); done", 1, 0);
+    defer shell.deinit();
+    var buffer: [256]u8 = undefined;
+    shell.start(std.testing.allocator, 0);
+    var result: ?[]const u8 = null;
+    for (0..200) |_| {
+        if (shell.collect(0, &buffer)) |content| {
+            result = content;
+            break;
+        }
+        _ = c.usleep(10000);
+    }
+    const content = result orelse return error.NoOutput;
+    try std.testing.expectEqual(@as(usize, 256), content.len);
+    for (content) |byte| try std.testing.expectEqual(@as(u8, '0'), byte);
+}
+
+test "a timed out helper is killed and reaped while the cached value is retained" {
+    var shell = Shell.init("{}", "sleep 60", 1, 0);
+    defer shell.deinit();
+    var buffer: [256]u8 = undefined;
+    @memcpy(buffer[0..8], "previous");
+    shell.start(std.testing.allocator, 0);
+    for (0..200) |_| {
+        try std.testing.expectEqual(null, shell.collect(30, &buffer));
+        if (!shell.running()) break;
+        _ = c.usleep(10000);
+    }
+    try std.testing.expect(!shell.running());
+    try std.testing.expectEqualStrings("previous", buffer[0..8]);
+}
+
+test "bar teardown closes descriptors and reaps its running helper" {
+    var shell = Shell.init("{}", "sleep 60", 1, 0);
+    shell.start(std.testing.allocator, 0);
+    const pid = shell.pid orelse return error.NoProcess;
+    const fd = shell.fd orelse return error.NoPipe;
+    shell.deinit();
+    try std.testing.expect(!shell.running());
+    try std.testing.expectEqual(@as(c_int, -1), c.fcntl(fd, c.F_GETFD));
+    var status: c_int = undefined;
+    try std.testing.expectEqual(@as(c.pid_t, -1), c.waitpid(pid, &status, c.WNOHANG));
+    try std.testing.expectEqual(c.ECHILD, c.__errno_location().*);
+}
