+    /// Drain a bounded amount of output without blocking the X11 event loop.
+    /// A faulty helper cannot grow memory, overlap launches, or run forever.
+    pub fn collect(self: *Shell, now: i64, buffer: []u8) ?[]const u8 {
+        if (self.running() and !self.timed_out and now - self.started_at >= 30) {
+            if (self.group) |group| _ = c.kill(-group, c.SIGKILL);
+            self.timed_out = true;
+        }
