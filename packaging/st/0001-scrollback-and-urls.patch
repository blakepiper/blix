+static const char *
+strstrany(const char *s, char *const strs[])
+{
+	const char *match = NULL;
+
+	for (int i = 0; strs[i]; i++) {
+		const char *candidate = strstr(s, strs[i]);
+		if (candidate && (!match || candidate < match))
+			match = candidate;
+	}
+
+	return match;
+}
