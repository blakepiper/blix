+void
+highlighturlsline(Line line)
+{
+	char *linestr = xmalloc((term.col + 1) * sizeof(*linestr));
+	const char *match;
+	int search = 0;
+
+	/* URL matching is intentionally ASCII-only. */
+	for (int i = 0; i < term.col; i++)
+		linestr[i] = line[i].u < 127 ? line[i].u : ' ';
+	linestr[term.col] = '\0';
+
+	while (search < term.col &&
+	       (match = strstrany(linestr + search, urlprefixes))) {
+		int start = match - linestr;
+		int end = start;
+
+		while (end < term.col && strchr(urlchars, linestr[end]))
+			end++;
+		for (int i = start; i < end; i++)
+			line[i].mode |= ATTR_URL;
+
+		/* Search past the prefix so embedded URLs cannot loop forever. */
+		search = start + 1;
+	}
+
+	free(linestr);
+}
+
+void
+unhighlighturlsline(Line line)
+{
+	for (int i = 0; i < term.col; i++)
+		line[i].mode &= ~ATTR_URL;
+}
+
+int
+followurl(int col, int row)
+{
+	Line line = getrenderline(row);
+	char *linestr = xmalloc((term.col + 1) * sizeof(*linestr));
+	const char *match;
+	int search = 0, url_start = -1, url_end = -1;
+
+	/* URL matching is intentionally ASCII-only. */
+	for (int i = 0; i < term.col; i++)
+		linestr[i] = line[i].u < 127 ? line[i].u : ' ';
+	linestr[term.col] = '\0';
+
+	while (search < term.col &&
+	       (match = strstrany(linestr + search, urlprefixes))) {
+		url_start = match - linestr;
+		url_end = url_start;
+		while (url_end < term.col && strchr(urlchars, linestr[url_end]))
+			url_end++;
+
+		if (url_start <= col && col < url_end)
+			break;
+
+		search = url_start + 1;
+		url_start = url_end = -1;
+	}
+
+	if (url_start < 0) {
+		free(linestr);
+		return 0;
+	}
+
+	linestr[url_end] = '\0';
+
+	/* Double-fork so the browser does not become a child of the shell. */
+	pid_t child = fork();
+	if (child == 0) {
+		if (fork() == 0) {
+			execlp(urlhandler, urlhandler, linestr + url_start,
+			       (char *)NULL);
+			_exit(1);
+		}
+		_exit(0);
+	}
+	if (child > 0)
+		waitpid(child, NULL, 0);
+
+	free(linestr);
+	return child > 0;
+}
