 )
+
+// Use GTK's symbolic rendering and an explicit size for navigation/session
+// icons. Loading these through raw pixbufs loses their foreground color, while
+// ICON_SIZE_DND silently gives folder icons inconsistent sizes.
+func themedImage(icon string, size int) *gtk.Image {
+	aliases := map[string]string{
+		"folder-home": "user-home-symbolic",
+		"folder-downloads": "folder-download-symbolic",
+		"applications-development": "applications-engineering-symbolic",
+		"applications-accessories": "applications-utilities-symbolic",
+		"applications-office": "x-office-document-symbolic",
+		"applications-other": "applications-utilities-symbolic",
+		"preferences-system-network": "network-workgroup-symbolic",
+		"dialog-cancel": "window-close-symbolic",
+	}
+	if replacement, ok := aliases[icon]; ok {
+		icon = replacement
+	} else if !strings.HasSuffix(icon, "-symbolic") {
+		icon += "-symbolic"
+	}
+	image, _ := gtk.ImageNewFromIconName(icon, gtk.ICON_SIZE_BUTTON)
+	image.SetPixelSize(size)
+	return image
+}
 
