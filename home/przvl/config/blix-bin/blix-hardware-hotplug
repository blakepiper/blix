#!/usr/bin/env bash
set -u

[[ -n ${DISPLAY:-} ]] || exit 0

display_number=${DISPLAY##*:}
display_number=${display_number%%.*}
xorg_log_path="${XDG_DATA_HOME:-$HOME/.local/share}/xorg/Xorg.${display_number}.log"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_path="$runtime_dir/blix-hardware-hotplug-$UID.pid"
internal_output=${BLIX_INTERNAL_OUTPUT:-eDP-1}
external_output=${BLIX_EXTERNAL_OUTPUT:-HDMI-2}
mirror_mode=${BLIX_MIRROR_MODE:-1920x1080}
mirror_rate=${BLIX_MIRROR_RATE:-60}
once_mode=0
[[ ${1:-} == --once ]] && once_mode=1

if (( ! once_mode )) && [[ -r $pid_path ]]; then
  read -r old_pid < "$pid_path" || old_pid=''
  if [[ $old_pid =~ ^[0-9]+$ ]] && [[ $old_pid != "$$" ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
fi
if (( ! once_mode )); then
  printf '%s\n' "$$" > "$pid_path" 2>/dev/null || exit 0
fi

input_monitor_pid=''
display_monitor_pid=''
cleanup() {
  [[ -z $input_monitor_pid ]] || kill "$input_monitor_pid" 2>/dev/null || true
  [[ -z $display_monitor_pid ]] || kill "$display_monitor_pid" 2>/dev/null || true
  (( once_mode )) || rm -f "$pid_path"
}
trap cleanup EXIT INT TERM

apply_gaming_keyboard() {
  local id
  local -a ids=()
  [[ -r $xorg_log_path ]] || return 0

  mapfile -t ids < <(
    sed -n 's/.*XINPUT: Adding extended input device "Gaming Keyboard" (type: KEYBOARD, id \([0-9][0-9]*\)).*/\1/p' \
      "$xorg_log_path" | tail -n 2
  )
  for id in "${ids[@]}"; do
    setxkbmap -device "$id" \
      -option '' \
      -option terminate:ctrl_alt_bksp \
      -option altwin:swap_alt_win us -print |
      xkbcomp -synch -i "$id" - "$DISPLAY" >/dev/null 2>&1 || true
  done
}

configure_external_monitor() {
  command -v xrandr >/dev/null 2>&1 || return 0

  local outputs
  outputs=$(xrandr --query 2>/dev/null) || return 0
  if printf '%s\n' "$outputs" | grep -Fq "${external_output} connected"; then
    # Mirror only while the external connector is actually present. The
    # internal panel uses the configured mirror mode in that arrangement.
    xrandr --output "$internal_output" --mode "$mirror_mode" --rate "$mirror_rate" >/dev/null 2>&1 || true
    xrandr --output "$external_output" --mode "$mirror_mode" --rate "$mirror_rate" --same-as "$internal_output" >/dev/null 2>&1 || true
  else
    # A disconnected output can retain an assigned CRTC after unplugging. Turn
    # it off explicitly so OXWM does not treat it as a second monitor, then let
    # the internal panel return to its preferred/native mode.
    xrandr --output "$external_output" --off >/dev/null 2>&1 || true
    xrandr --output "$internal_output" --auto >/dev/null 2>&1 || true
  fi
}

apply_gaming_keyboard
configure_external_monitor
[[ ${1:-} == --once ]] && exit 0

watch_keyboard() {
  local line action='' vendor='' model=''
  while IFS= read -r line; do
    if [[ -z $line ]]; then
      if [[ $action == add && $vendor == 1fc9 && $model == e8c7 ]]; then
        sleep 1
        apply_gaming_keyboard
      fi
      action=''
      vendor=''
      model=''
    elif [[ $line == ACTION=* ]]; then
      action=${line#ACTION=}
    elif [[ $line == ID_VENDOR_ID=* ]]; then
      vendor=${line#ID_VENDOR_ID=}
    elif [[ $line == ID_MODEL_ID=* ]]; then
      model=${line#ID_MODEL_ID=}
    fi
  done
}

watch_display() {
  local line action='' hotplug=''
  while IFS= read -r line; do
    if [[ -z $line ]]; then
      if [[ $action == change && $hotplug == 1 ]]; then
        sleep 1
        configure_external_monitor
      fi
      action=''
      hotplug=''
    elif [[ $line == ACTION=* ]]; then
      action=${line#ACTION=}
    elif [[ $line == HOTPLUG=* ]]; then
      hotplug=${line#HOTPLUG=}
    fi
  done
}

udevadm monitor --udev --property --subsystem-match=input 2>/dev/null | watch_keyboard &
input_monitor_pid=$!
udevadm monitor --udev --property --subsystem-match=drm 2>/dev/null | watch_display &
display_monitor_pid=$!
wait "$input_monitor_pid" "$display_monitor_pid"
