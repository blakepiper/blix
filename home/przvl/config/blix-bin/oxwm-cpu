#!/bin/sh
set -eu

# Report total CPU usage since the previous bar update. The state file lives
# in the per-user runtime directory and is replaced atomically.
state_root=${XDG_RUNTIME_DIR:-/tmp}
state_file="$state_root/oxwm-cpu-$(id -u)"

cpu_line=$(awk '/^cpu / { print; exit }' /proc/stat)
# Intentionally split the numeric /proc/stat fields into positional arguments.
# shellcheck disable=SC2086
set -- $cpu_line
[ "$#" -ge 5 ] || exit 0
shift

user=${1:-0}
nice_time=${2:-0}
system=${3:-0}
idle=${4:-0}
iowait=${5:-0}
irq=${6:-0}
softirq=${7:-0}
steal=${8:-0}

total=$((user + nice_time + system + idle + iowait + irq + softirq + steal))
idle_total=$((idle + iowait))
previous_total=0
previous_idle=0

if [ -r "$state_file" ]; then
  read -r previous_total previous_idle < "$state_file" || true
fi

usage=0
if [ "$previous_total" -gt 0 ] && [ "$total" -gt "$previous_total" ]; then
  total_delta=$((total - previous_total))
  idle_delta=$((idle_total - previous_idle))
  [ "$idle_delta" -ge 0 ] || idle_delta=0
  usage=$(( (100 * (total_delta - idle_delta) + total_delta / 2) / total_delta ))
  [ "$usage" -le 100 ] || usage=100
  [ "$usage" -ge 0 ] || usage=0
fi

state_tmp="$state_file.$$"
trap 'rm -f "$state_tmp"' EXIT
umask 077
printf '%s %s\n' "$total" "$idle_total" > "$state_tmp"
mv -f "$state_tmp" "$state_file"
trap - EXIT

printf '%s\n' "$usage"
