{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin"
    },
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "host",
            "format": "{?family}{family}{?}{/family}{name}{/}"
        },
        "kernel",
        "uptime",
        {
            "type": "command",
            "key": "Packages",
            "text": "blix-fastfetch-packages"
        },
        "shell",
        {
            "type": "display",
            "compactType": "original"
        },
        "de",
        {
            "type": "wm",
            "key": "WM"
        },
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        {
            "type": "terminalfont",
            "key": "Term Font"
        },
        {
            "type": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "format": "{vendor} {type}"
        },
        "memory",
        "swap",
        {
            "type": "disk",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        "localip",
        {
            "type": "battery",
            "key": "Battery"
        },
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
